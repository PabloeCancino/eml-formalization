{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lean: update deps",
      "type": "shell",
      "command": "lake update",
      "options": {
        "cwd": "${workspaceFolder}/lean4"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lean: build",
      "type": "shell",
      "command": "lake build",
      "options": {
        "cwd": "${workspaceFolder}/lean4"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "Lean: update deps",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
